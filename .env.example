# Shared Khatmah (Supabase). Copy to .env.local for development.
# Use the Project URL and the PUBLISHABLE key from Supabase → Project Settings → API.
# Never put a service_role / secret key here.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# Older Supabase projects may call the publishable value the "anon key".
# The app accepts this as a fallback if the variable above is not set.
# VITE_SUPABASE_ANON_KEY=eyJhbGciOi...
